<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1.} - %m%n%throwable"/>
        </Console>

        <File name="FileAppender" fileName="logs/app.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1.} - %m%n%throwable"/>
        </File>

        <!--
          SMTP-апендер: надсилає email при рівні ERROR і вище.

          Щоб активувати реальне надсилання листів (Gmail):
            1. Увімкніть двофакторну автентифікацію у Google-акаунті.
            2. Створіть "Пароль застосунку" (Google Account → Security → App passwords).
            3. Вставте згенерований 16-символьний пароль у поле smtpPassword нижче.
            4. Якщо пароль не вказано — апендер мовчки ігнорує помилку (ignoreExceptions="true")
               і програма продовжує роботу без email-сповіщення.
        -->
        <SMTP name="EmailAppender"
              to="dimakipen2006@gmail.com"
              from="dimakipen2006@gmail.com"
              subject="CRITICAL error in MavenCW app"
              smtpHost="smtp.gmail.com"
              smtpPort="465"
              smtpProtocol="smtps"
              smtpUsername="dimakipen2006@gmail.com"
              smtpPassword=""
              bufferSize="1"
              smtpDebug="false"
              ignoreExceptions="true">

            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c - %m%n%throwable"/>

            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
        </SMTP>

    </Appenders>

    <Loggers>
        <!-- Логер для всього твого додатку -->
        <Logger name="com.org.insurance" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
            <AppenderRef ref="EmailAppender"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
            <AppenderRef ref="EmailAppender"/>
        </Root>
    </Loggers>
</Configuration>
